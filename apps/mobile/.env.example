# 앱에 들어가는 값은 누구나 꺼내 볼 수 있다. 공개해도 되는 값만 둔다.
# 복사해서 apps/mobile/.env 로 쓴다.

# Supabase 프로젝트 주소와 공개 키(Publishable key, sb_publishable_…). 비밀 키(sb_secret_…)는 절대 넣지 않는다.
# 대시보드 > Project Settings > API Keys 에서 복사한다.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 카카오 네이티브 앱 키 (카카오 로그인 · 카카오톡 공유)
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
