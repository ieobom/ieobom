# 서버 함수(Edge Functions)만 쓰는 비밀값. 복사해서 supabase/functions/.env 로 쓰고,
# 배포할 때는 `supabase secrets set --env-file supabase/functions/.env` 로 올린다.
# SUPABASE_URL · SUPABASE_SERVICE_ROLE_KEY 는 Supabase가 자동으로 넣어 준다.

# AI: Gemini 3.5 Flash-Lite를 OpenAI 호환 방식으로 부른다. 모델을 바꿀 때는 이 세 줄만 바꾼다.
# 결제를 켠 Google Cloud 프로젝트(유료 등급)의 키만 쓴다. 무료 등급 키에는 실제 메모를 보내지 않는다.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# 말 → 글: 리턴제로 또는 CLOVA Speech 중 고른 쪽만 채운다
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=

# 앱 안 음성 통화 — 업체를 정하면 이름을 맞춘다 (추천: Agora)
CALL_APP_ID=
CALL_APP_CERTIFICATE=

# 걸려온 전화 알림: Apple PushKit
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=

# 걸려온 전화 알림: Google FCM (서비스 계정 JSON 한 줄)
FCM_SERVICE_ACCOUNT_JSON=

# 일반 알림: Expo 알림 (보안 발송을 켰을 때만)
EXPO_ACCESS_TOKEN=

# 탈퇴할 때 카카오 연결 끊기
KAKAO_ADMIN_KEY=
