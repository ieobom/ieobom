{
  "name": "ieobom",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "structure": "node scripts/update-structure.mjs",
    "structure:check": "node scripts/update-structure.mjs --check",
    "db:types": "supabase gen types typescript --linked --schema public > supabase/functions/_shared/database.types.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p packages/shared && tsc -p apps/mobile",
    "fn:lint": "deno lint --config supabase/functions/deno.json supabase/functions",
    "fn:check": "deno check --config supabase/functions/deno.json supabase/functions",
    "fn:test": "deno test --config supabase/functions/deno.json supabase/functions",
    "app": "pnpm --filter @ieobom/mobile start",
    "app:web": "pnpm --filter @ieobom/mobile exec expo start --web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "deno": "^2.9.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
